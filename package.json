{
  "name": "@plutoframework/frontend",
  "version": "0.2.1",
  "description": "Explicit, typed frontend state transitions and React subscriptions for Pluto applications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutoframework/pluto-frontend.git"
  },
  "homepage": "https://github.com/plutoframework/pluto-frontend#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "@tanstack/react-query": "^5.105.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt": "node scripts/format.mjs && eslint .",
    "check": "node scripts/format.mjs --check && eslint . && tsc --noEmit && npm test && npm run build",
    "test": "vitest run && node --test scripts/format.test.mjs",
    "test:mutation": "python3 scripts/mutation.py",
    "prepack": "npm run build",
    "example:actions": "node scripts/example-actions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "@tanstack/react-query": "5.105.0"
  }
}
