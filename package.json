{
  "name": "@plutoframework/frontend",
  "version": "0.1.1",
  "description": "Explicit, typed frontend state transitions and React subscriptions for Pluto applications.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutoframework/pluto-frontend.git"
  },
  "homepage": "https://github.com/plutoframework/pluto-frontend#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    "./state": {
      "types": "./dist/state/index.d.ts",
      "import": "./dist/state/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "fmt": "prettier --write .",
    "check": "prettier --check . && tsc --noEmit && npm test && npm run build",
    "test": "vitest run",
    "test:mutation": "python3 scripts/mutation.py",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "fast-check": "4.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/react": "16.3.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10"
  }
}
